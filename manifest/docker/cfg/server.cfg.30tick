// Disable consistency checks.
sv_consistency 0

// Remove the player limit.
sv_setmax 32

// Network settings.
sm_cvar fps_max "0"
sv_minrate 30000
sv_maxrate 30000

// Region code: 0 - US East Coast, 1 - US West Coast, 2 - South America, 3 - Europe, 4 - Asia, 5 - Australia, 6 - Middle East, 7 - Africa, 255 - World.
sm_cvar sv_region "4"

// Seconds before an inactive player is moved to idle.
sm_cvar director_afk_timeout "20"

// Allow bots to use melee weapons? 0=disable, 1=enable.
sm_cvar sb_melee_approach_victim "1"

// Set how many bots may use melee weapons.
sm_cvar sb_max_team_melee_weapons "8"

// Bot survivors use medkits when health is below this factor (default: 0.5).
//sm_cvar sb_temp_health_think_factor "0.5"

// Fall damage above this value kills immediately (default: 200).
//sm_cvar survivor_incap_max_fall_damage "200"

// Number of times a player can be incapacitated (default: 2).
sm_cvar survivor_max_incapacitated_count "2"

// Set the game mode: "coop=campaign, versus=versus, survival=survival, realism=realism".
//sm_cvar mp_gamemode "coop"

// Set the default difficulty: Easy, Normal, Hard, or Impossible.
//sm_cvar z_difficulty "Hard"

// RCON administrator password.
rcon_password "lajijipangzi"

// Reset all weapon attributes.
sm_weapon_attributes_reset
// Set Scout sniper damage.
sm_weapon sniper_scout damage 375
// Set AWP damage.
sm_weapon sniper_awp damage 425
// Set grenade launcher clip size.
sm_weapon grenade_launcher clipsize 3

// [L4D2-MANAGER-GAME-BANS]
exec banned_user.cfg
exec banned_ip.cfg

sv_tags hidden
sm_cvar sv_allow_lobby_connect_only "0"
